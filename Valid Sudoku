#include <stdbool.h>

bool isValidSudoku(char** board, int boardSize, int* boardColSize) {
    
    int rows[9][10] = {0};
    int cols[9][10] = {0};
    int boxes[9][10] = {0};

    for (int r = 0; r < 9; r++) {
        for (int c = 0; c < 9; c++) {
            char val = board[r][c];

            
            if (val == '.') {
                continue;
            }

            
            int num = val - '0';

            
            int box_index = (r / 3) * 3 + (c / 3);

           
            if (rows[r][num] == 1 || cols[c][num] == 1 || boxes[box_index][num] == 1) {
                return false;
            }

            
            rows[r][num] = 1;
            cols[c][num] = 1;
            boxes[box_index][num] = 1;
        }
    }

    return true;
}
